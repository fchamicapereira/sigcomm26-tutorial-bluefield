/* The pipeline a participant builds in Part D of the DOCA Flow guide, and nothing else.
 *
 * Deliberately minimal: pipe names, the direction of traffic, and which section builds each one.
 * No vports, no domains, no API calls, no run-time branching on --percent. It sits immediately
 * before D.1 so the reader can see the shape of the finished thing before writing any of it, and
 * every box in it is either a function they write or the one worked example they are given.
 *
 * NOT the same figure as pf0-eswitch-pipes.dot, which is the full eSwitch view including the
 * capture path. That path is no longer part of the exercise; this file is what the guide uses.
 *
 * Pipe names must match doca_flow_solution.c exactly -- PORT_DEMUX, RANDOM_SAMPLE, MARK, PASS,
 * PASSTHROUGH. The older figure went stale on exactly this and cost a review cycle.
 *
 * PASSTHROUGH shares a rank with MARK and PASS rather than taking one of its own. It is only ever
 * reached from them, so in rankdir=LR a rank of its own would add a whole column for one box and
 * push the figure past what fits at page width; on the same rank the two miss edges simply drop
 * down to it.
 *
 * Drawn in the --percent-between-0-and-100 shape, the one D.3 ends at: RANDOM_SAMPLE present, both
 * MARK and PASS built. At 0 or 100 the wire feeds one of them directly and RANDOM_SAMPLE does not
 * exist, which the guide says in prose rather than drawing three variants here.
 */
digraph tutorial_flow_pipeline {
  /* Left-to-right: it is a chain and reads as one.
   *
   * Keep the edge labels SHORT. In rankdir=LR graphviz lays each one out as a virtual node BETWEEN
   * ranks, so a wordy label physically pushes two columns apart -- an earlier draft with "from the
   * wire" and "the rest" on these edges came out at 6:1 and was unusable at page width.
   *
   * The return leg (server SF back out to the wire, PORT_DEMUX's second entry) is deliberately NOT
   * drawn: in LR it has to sweep back across every rank. The guide says it in a sentence instead. */
  rankdir=LR;
  fontname="Helvetica";
  bgcolor="transparent";
  nodesep=0.28;
  ranksep=0.45;
  node [fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=9, color="#666666", arrowsize=0.7];

  /* Endpoints and the drop, drawn as bare text so only the pipes read as boxes.
   *
   * The ingress names the PEER, not just the port. Labelled "wire (p0)" it kept prompting "so what
   * happens to the traffic from p1?" -- Part A has just established that the client is the thing on
   * p1, and p0 does not obviously read as "the client's packets, one cable-hop later". PF1 has its
   * own eSwitch domain, which this program never touches; its traffic reaches PF0 as p0 ingress and
   * that is the only way in. Naming both ports here answers the question inside the figure. */
  node [shape=plaintext];
  wire [label="from the client\n(out p1, in on p0)"];
  sf   [label="server SF"];
  drop [label="drop", fontcolor="#b03030"];

  /* The pipes. Blue = you write it, and the section that does; grey = given to you. */
  node [shape=box, style="rounded,filled", color="#7f9db9", penwidth=1.0,
        height=0.34, margin="0.14,0.07", fillcolor="#dce9f6"];
  /* Two-row TABLE labels, not name<BR/>tag: with <BR/> the underscore in PORT_DEMUX and
   * RANDOM_SAMPLE descends onto the line below and strikes through the D.n. */
  demux  [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD>PORT_DEMUX</TD></TR><TR><TD><FONT POINT-SIZE="8" COLOR="#5a7fa6">D.1</FONT></TD></TR></TABLE>>];
  sample [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD>RANDOM_SAMPLE</TD></TR><TR><TD><FONT POINT-SIZE="8" COLOR="#5a7fa6">D.3</FONT></TD></TR></TABLE>>];
  mark   [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD>MARK</TD></TR><TR><TD><FONT POINT-SIZE="8" COLOR="#5a7fa6">D.2</FONT></TD></TR></TABLE>>];
  pass   [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD>PASS</TD></TR><TR><TD><FONT POINT-SIZE="8" COLOR="#5a7fa6">D.2</FONT></TD></TR></TABLE>>];

  /* Grey: given to you, not written in any section -- hence no D.n tag and a single-row label. */
  pt     [label="PASSTHROUGH", color="#a8a8a8", fillcolor="#ededed"];

  /* Wire ingress: the path the exercise is about. */
  wire   -> demux;
  demux  -> sample;
  sample -> mark   [label=" 1 in N "];
  sample -> pass   [label=" rest "];
  mark   -> sf;
  pass   -> sf;
  pt     -> sf;

  /* Dashed means one thing and one thing only: this is a MISS forward. MARK and PASS match IPv4,
   * so their miss is ARP and the like, and it lands in PASSTHROUGH, which forwards everything.
   * Only PORT_DEMUX's miss is a drop. The caption carries the meaning. */
  mark  -> pt   [style=dashed];
  pass  -> pt   [style=dashed];
  demux -> drop [style=dashed];

  /* One rank for all three, ordered MARK / PASSTHROUGH / PASS by the invisible edges: with
   * PASSTHROUGH between them each miss is a short hop, where putting it last made MARK's miss
   * sweep back across the figure to get around PASS. */
  { rank=same; mark; pt; pass; }
  mark -> pt -> pass [style=invis];
}
